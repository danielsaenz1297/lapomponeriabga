---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Carrito from '../components/Carrito.astro';
import ModalBolsa from '../components/ModalBolsa.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import { negocio } from '../data/config';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = `${negocio.nombre} · ${negocio.marcaProducto}`,
  descripcion = negocio.descripcionCorta,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    <!-- Open Graph / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content="/img/marca/hero-aromapoms.jpeg" />
    <meta property="og:locale" content="es_CO" />
    <meta name="theme-color" content="#E6168B" />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Carrito />
    <ModalBolsa />
    <BotonWhatsApp />
  </body>
</html>
