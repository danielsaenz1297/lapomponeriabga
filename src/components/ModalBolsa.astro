---
import { bolsas } from '../data/bolsas';
---

<!-- Overlay del modal de bolsa -->
<div
  id="bolsa-overlay"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-marca-morado/50 p-4 backdrop-blur-sm"
  aria-hidden="true"
>
  <div
    id="bolsa-modal"
    class="flex max-h-[90vh] w-full max-w-2xl flex-col overflow-hidden rounded-3xl bg-white shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="bolsa-titulo"
  >
    <!-- Encabezado -->
    <div class="flex items-center justify-between border-b border-marca-rosa/40 bg-marca-rosaClaro px-5 py-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-wide text-marca-lila">Paso 2 de 2</p>
        <h2 id="bolsa-titulo" class="font-display text-xl font-extrabold text-marca-morado">
          Elige la bolsa de regalo 🎁
        </h2>
        <p id="bolsa-subtitulo" class="text-sm text-marca-morado/70">Incluida sin costo adicional</p>
      </div>
      <button
        type="button"
        id="btn-cerrar-bolsa"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white text-marca-morado transition hover:bg-marca-rosa/40"
        aria-label="Cerrar"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Grilla de bolsas -->
    <div class="grid grid-cols-2 gap-3 overflow-y-auto p-5 sm:grid-cols-3">
      {bolsas.map((b, i) => (
        <button
          type="button"
          class="opcion-bolsa relative flex flex-col overflow-hidden rounded-2xl border-2 border-marca-rosa/40 bg-white text-left transition hover:border-marca-fucsia focus:outline-none focus-visible:ring-4 focus-visible:ring-marca-fucsia/30"
          data-bolsa-id={b.id}
          data-bolsa-nombre={b.nombre}
          data-bolsa-imagen={b.lado1}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          <div class="relative aspect-square overflow-hidden bg-marca-rosaClaro">
            <img src={b.lado1} alt={`Bolsa ${b.nombre}`} class="h-full w-full object-cover" loading="lazy" />
            {b.lado2 && (
              <img src={b.lado2} alt={`Bolsa ${b.nombre} reverso`} class="miniatura-lado2 absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300 hover:opacity-100" loading="lazy" />
            )}
            <span class="indicador-check absolute right-2 top-2 hidden h-6 w-6 items-center justify-center rounded-full bg-marca-fucsia text-xs font-bold text-white">✓</span>
          </div>
          <span class="px-2 py-2 text-center text-xs font-bold text-marca-morado">{b.nombre}</span>
        </button>
      ))}
    </div>

    <!-- Pie -->
    <div class="border-t border-marca-rosa/40 bg-marca-crema px-5 py-4">
      <button type="button" id="btn-confirmar-bolsa" class="btn-primario w-full">
        Agregar al pedido 🛍️
      </button>
    </div>
  </div>
</div>
