---
import Logo from './Logo.astro';

const navItems = [
  { label: 'Inicio', href: '/#inicio' },
  { label: 'Aromas', href: '/#aromas' },
  { label: 'Bolsas', href: '/#bolsas' },
  { label: 'Características', href: '/#caracteristicas' },
  { label: 'Cómo funciona', href: '/#como-funciona' },
  { label: 'Nosotras', href: '/#nosotras' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-marca-rosa/40 bg-marca-crema/90 backdrop-blur-md">
  <div class="contenedor flex h-16 items-center justify-between gap-4">
    <Logo />

    <!-- Navegación de escritorio -->
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-sm font-bold text-marca-morado/80 transition-colors hover:text-marca-fucsia"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <!-- Botón del carrito -->
      <button
        type="button"
        id="btn-abrir-carrito"
        class="relative inline-flex h-11 w-11 items-center justify-center rounded-full bg-white text-marca-fucsia shadow-sm transition hover:bg-marca-rosaClaro"
        aria-label="Abrir carrito de compras"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
        </svg>
        <span
          id="contador-carrito"
          class="absolute -right-1 -top-1 hidden min-w-[1.25rem] items-center justify-center rounded-full bg-marca-fucsia px-1 text-xs font-bold text-white"
        >0</span>
      </button>

      <!-- Botón menú móvil -->
      <button
        type="button"
        id="btn-menu-movil"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white text-marca-morado shadow-sm lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil desplegable -->
  <nav id="menu-movil" class="hidden border-t border-marca-rosa/40 bg-marca-crema lg:hidden" aria-label="Navegación móvil">
    <div class="contenedor flex flex-col py-3">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="menu-movil-link rounded-xl px-3 py-3 text-base font-bold text-marca-morado/90 transition hover:bg-marca-rosaClaro hover:text-marca-fucsia"
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btnMenu = document.getElementById('btn-menu-movil');
  const menu = document.getElementById('menu-movil');
  btnMenu?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    btnMenu.setAttribute('aria-expanded', String(abierto));
  });
  // Cerrar el menú al navegar
  document.querySelectorAll('.menu-movil-link').forEach((a) =>
    a.addEventListener('click', () => menu?.classList.add('hidden'))
  );
</script>
