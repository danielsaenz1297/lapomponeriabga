---
import { incluye, comoUsar } from '../../data/config';
---

<section id="como-funciona" class="scroll-mt-20 bg-marca-rosaClaro py-16">
  <div class="contenedor">
    <div class="mx-auto max-w-2xl text-center">
      <span class="chip bg-white">💡 Fácil y práctico</span>
      <h2 class="titulo-seccion mt-3">¿Cómo funciona?</h2>
      <p class="mt-3 text-marca-morado/70">
        Un detalle diferente para cada ocasión. Así se usa tu AromaPom.
      </p>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <!-- Qué incluye -->
      <div class="rounded-3xl bg-white p-6 shadow-tarjeta ring-1 ring-marca-rosa/30">
        <h3 class="font-display text-xl font-extrabold text-marca-fucsia">¿Qué incluye?</h3>
        <ul class="mt-4 space-y-3">
          {incluye.map((item) => (
            <li class="flex items-start gap-3 text-marca-morado/80">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-marca-rosaClaro text-sm text-marca-fucsia">✓</span>
              <span class="text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Cómo se usa -->
      <div class="rounded-3xl bg-white p-6 shadow-tarjeta ring-1 ring-marca-rosa/30">
        <h3 class="font-display text-xl font-extrabold text-marca-lila">¿Cómo se usa?</h3>
        <ol class="mt-4 space-y-3">
          {comoUsar.map((paso, i) => (
            <li class="flex items-start gap-3 text-marca-morado/80">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-marca-fucsia text-sm font-bold text-white">{i + 1}</span>
              <span class="text-sm">{paso}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <!-- Video explicativo -->
    <div class="mt-10 flex justify-center">
      <div class="w-full max-w-xs overflow-hidden rounded-3xl bg-black shadow-suave ring-4 ring-white">
        <video
          class="h-auto w-full"
          controls
          playsinline
          preload="metadata"
          poster="/video/como-funciona-poster.jpg"
          aria-label="Video: cómo se arma y usa el AromaPom"
        >
          <source src="/video/como-funciona.mp4" type="video/mp4" />
          Tu navegador no admite la reproducción de video.
        </video>
      </div>
    </div>
    <p class="mt-3 text-center text-sm text-marca-morado/60">▶️ Mira cómo preparar tu AromaPom</p>
  </div>
</section>
