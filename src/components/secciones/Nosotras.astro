---
import { negocio, beneficios } from '../../data/config';
---

<section id="nosotras" class="scroll-mt-20 py-16">
  <div class="contenedor">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div>
        <span class="chip">💜 Nuestra historia</span>
        <h2 class="titulo-seccion mt-3">Pequeños detalles, grandes momentos</h2>
        <p class="mt-4 text-marca-morado/80">
          {negocio.descripcionLarga}
        </p>
        <p class="mt-3 text-marca-morado/70">
          Aromas que inspiran, mensajes que conectan. Cada AromaPom lleva color, cariño y un
          mensaje positivo para alegrar tus espacios o sorprender a quien quieres.
        </p>
      </div>

      <!-- Beneficios de fidelidad -->
      <div class="space-y-3">
        {beneficios.map((b) => (
          <div class="flex items-start gap-3 rounded-2xl bg-marca-rosaClaro p-4">
            <span class="text-2xl" aria-hidden="true">
              {b.icono === 'descuento' ? '🏷️' : b.icono === 'regalo' ? '🎁' : '💝'}
            </span>
            <div>
              <p class="font-bold text-marca-morado">{b.titulo}</p>
              <p class="text-sm text-marca-morado/70">{b.detalle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Galería de fotos -->
    <div class="mt-10 grid items-start gap-6 md:grid-cols-3">
      <figure class="overflow-hidden rounded-3xl shadow-suave ring-4 ring-white">
        <img src="/img/personalizacion/personalizacion-1.webp" alt="AromaPom personalizado: etiqueta con el logo de tu empresa, tarjeta o mensaje, empaque con tu imagen y diseño a tu estilo" class="h-auto w-full" width="1000" height="1094" loading="lazy" />
      </figure>
      <figure class="overflow-hidden rounded-3xl shadow-suave ring-4 ring-white">
        <img src="/img/personalizacion/personalizacion-2.webp" alt="Ejemplo de AromaPom personalizado para empresa con pompón, etiqueta, frasco de vidrio y bolsa de regalo" class="h-auto w-full" width="1000" height="1333" loading="lazy" />
      </figure>
      <figure class="overflow-hidden rounded-3xl shadow-suave ring-4 ring-white">
        <img src="/img/personalizacion/personalizacion-3.webp" alt="Difusores personalizados para empresas: condiciones comerciales, forma de pago y tiempos de entrega" class="h-auto w-full" width="1000" height="1094" loading="lazy" />
      </figure>
    </div>
  </div>
</section>
