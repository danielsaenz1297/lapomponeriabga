---
import { negocio, precios } from '../../data/config';
---

<section id="inicio" class="relative overflow-hidden bg-degradado-marca">
  <!-- Burbujas decorativas -->
  <div class="pointer-events-none absolute -left-16 -top-16 h-64 w-64 rounded-full bg-marca-rosa/30 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-10 top-20 h-56 w-56 rounded-full bg-marca-lila/20 blur-3xl"></div>

  <div class="contenedor relative grid items-center gap-10 py-14 md:grid-cols-2 md:py-20">
    <div>
      <span class="chip bg-white text-marca-fucsia">✨ {negocio.eslogan2}</span>
      <h1 class="mt-4 font-display text-4xl font-extrabold leading-tight text-marca-morado sm:text-5xl lg:text-6xl">
        <span class="text-marca-lila">Aroma</span><span class="text-marca-fucsia">Poms</span>
      </h1>
      <p class="mt-3 text-xl font-bold text-marca-morado/90">
        Difusor artesanal de aromas con kit de reciclaje 💜
      </p>
      <p class="mt-4 max-w-md text-marca-morado/70">
        {negocio.descripcionCorta}
      </p>

      <!-- Precio destacado -->
      <div class="mt-6 inline-flex flex-wrap items-center gap-3 rounded-2xl bg-white/70 p-3 shadow-suave">
        <span class="rounded-xl bg-marca-fucsia px-4 py-2 font-display text-lg font-extrabold text-white">
          ${precios.unidad.toLocaleString('es-CO')} c/u
        </span>
        <span class="text-sm font-semibold text-marca-morado/70">Elige entre 15 aromas únicos · bolsa de regalo incluida</span>
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <a href="#aromas" class="btn-primario">Ver aromas 🌈</a>
        <a href="#como-funciona" class="btn-contorno">¿Cómo funciona?</a>
      </div>

      <!-- Mini-beneficios -->
      <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-marca-morado/70">
        <li class="inline-flex items-center gap-1.5">🌿 Larga duración</li>
        <li class="inline-flex items-center gap-1.5">♻️ Kit de reciclaje</li>
        <li class="inline-flex items-center gap-1.5">💜 Hecho a mano</li>
        <li class="inline-flex items-center gap-1.5">🎁 Ideal para regalar</li>
      </ul>
    </div>

    <div class="relative">
      <div class="overflow-hidden rounded-3xl shadow-suave ring-4 ring-white">
        <img
          src="/img/marca/hero-aromapoms.jpeg"
          alt="Catálogo de La Pomponería BGA: los 15 aromas de los AromaPoms, precio y datos de contacto"
          class="h-full w-full object-cover"
          width="843"
          height="1264"
          fetchpriority="high"
        />
      </div>
      <span class="absolute -bottom-4 -left-4 rotate-[-6deg] rounded-2xl bg-marca-amarillo px-4 py-2 font-display font-extrabold text-marca-morado shadow-tarjeta">
        ¡Llévalos ahora! 💛
      </span>
    </div>
  </div>
</section>
