---
import { negocio, mediosPago } from '../../data/config';

const iconosPago: Record<string, string> = {
  banco: '🏦',
  nequi: '📲',
  daviplata: '💜',
  efectivo: '💵',
};

const waPedido = `https://wa.me/${negocio.whatsapp.numero}?text=${encodeURIComponent('¡Hola La Pomponería BGA! 💜 Quiero hacer un pedido de AromaPoms.')}`;
---

<section id="contacto" class="scroll-mt-20 bg-degradado-marca py-16">
  <div class="contenedor">
    <div class="mx-auto max-w-2xl text-center">
      <span class="chip bg-white">🛒 Haz tu pedido</span>
      <h2 class="titulo-seccion mt-3">Pedidos, pagos y envíos</h2>
      <p class="mt-3 text-marca-morado/70">
        ¡Elige tu favorito y regálate un detalle especial! Coordinamos todo por WhatsApp.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      <!-- Cómo comprar -->
      <div class="rounded-3xl bg-white p-6 shadow-tarjeta ring-1 ring-marca-rosa/30">
        <div class="text-3xl">🛍️</div>
        <h3 class="mt-3 font-display text-lg font-extrabold text-marca-morado">¿Cómo comprar?</h3>
        <ol class="mt-3 space-y-2 text-sm text-marca-morado/70">
          <li>1. Elige tu aroma favorito.</li>
          <li>2. Escoge la bolsa de regalo (incluida sin costo).</li>
          <li>3. Pulsa “Finalizar pedido por WhatsApp”.</li>
          <li>4. Confirmamos disponibilidad, pago y envío por chat.</li>
        </ol>
      </div>

      <!-- Medios de pago -->
      <div class="rounded-3xl bg-white p-6 shadow-tarjeta ring-1 ring-marca-rosa/30">
        <div class="text-3xl">💳</div>
        <h3 class="mt-3 font-display text-lg font-extrabold text-marca-morado">Medios de pago</h3>
        <ul class="mt-3 grid grid-cols-2 gap-2">
          {mediosPago.map((m) => (
            <li class="flex items-center gap-2 rounded-xl bg-marca-rosaClaro px-3 py-2 text-sm font-semibold text-marca-morado/80">
              <span aria-hidden="true">{iconosPago[m.icono] ?? '💜'}</span> {m.nombre}
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-marca-morado/60">
          Los datos de pago se comparten directamente por WhatsApp al confirmar tu pedido.
        </p>
      </div>

      <!-- Envíos -->
      <div class="rounded-3xl bg-white p-6 shadow-tarjeta ring-1 ring-marca-rosa/30">
        <div class="text-3xl">🚚</div>
        <h3 class="mt-3 font-display text-lg font-extrabold text-marca-morado">Envíos</h3>
        <p class="mt-3 text-sm text-marca-morado/70">{negocio.cobertura}</p>
        <p class="mt-2 text-sm font-semibold text-marca-lila">📍 {negocio.ciudad}</p>
      </div>
    </div>

    <!-- CTA + redes -->
    <div class="mt-10 grid items-center gap-8 rounded-3xl bg-white p-8 shadow-suave ring-1 ring-marca-rosa/30 md:grid-cols-2">
      <div>
        <h3 class="font-display text-2xl font-extrabold text-marca-morado">
          ¿List@ para tu AromaPom? 💜
        </h3>
        <p class="mt-2 text-marca-morado/70">
          Escríbenos directamente y con gusto te asesoramos para elegir tu aroma ideal.
        </p>
        <a href={waPedido} target="_blank" rel="noopener" class="btn-whatsapp mt-5">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24z"/>
          </svg>
          Escríbenos: {negocio.whatsapp.numeroVisible}
        </a>
      </div>

      <div class="flex flex-col gap-3">
        <p class="font-bold text-marca-morado">Síguenos y descubre más 💖</p>
        <a href={negocio.redes.instagram.url} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-2xl bg-gradient-to-r from-[#F58529] via-[#DD2A7B] to-[#8134AF] p-4 text-white transition hover:opacity-90">
          <span class="text-2xl" aria-hidden="true">📸</span>
          <span>
            <span class="block text-sm opacity-80">Instagram</span>
            <span class="font-bold">{negocio.redes.instagram.usuario}</span>
          </span>
        </a>
        <a href={negocio.redes.tiktok.url} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-2xl bg-marca-morado p-4 text-white transition hover:opacity-90">
          <span class="text-2xl" aria-hidden="true">🎵</span>
          <span>
            <span class="block text-sm opacity-80">TikTok</span>
            <span class="font-bold">{negocio.redes.tiktok.usuario}</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
