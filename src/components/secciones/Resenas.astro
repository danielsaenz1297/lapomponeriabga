---
// Sección de reseñas (dinámica, lee/escribe en /api/resenas vía Cloudflare D1).
// En desarrollo local sin la función, muestra un estado amable de "aún no hay reseñas".
---

<section id="resenas" class="scroll-mt-20 bg-marca-rosaClaro py-16">
  <div class="contenedor">
    <div class="mx-auto max-w-2xl text-center">
      <span class="chip bg-white">⭐ Lo que dicen nuestras clientas</span>
      <h2 class="titulo-seccion mt-3">Reseñas</h2>
      <p class="mt-3 text-marca-morado/70">
        Historias reales de quienes ya tienen su AromaPom. ¿Ya tienes el tuyo? ¡Cuéntanos tu experiencia!
      </p>
    </div>

    <!-- Lista de reseñas -->
    <div id="resenas-lista" class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <p id="resenas-cargando" class="col-span-full text-center text-marca-morado/60">Cargando reseñas…</p>
      <p id="resenas-vacio" class="col-span-full hidden text-center text-marca-morado/60">
        Aún no hay reseñas publicadas. ¡Sé la primera en dejar la tuya! 💜
      </p>
    </div>

    <!-- Botón para abrir el formulario -->
    <div class="mt-10 text-center">
      <button type="button" id="btn-abrir-resena" class="btn-primario">Escribir una reseña ✍️</button>
    </div>

    <!-- Formulario (oculto hasta pulsar el botón) -->
    <form id="form-resena" class="mx-auto mt-6 hidden max-w-lg rounded-3xl bg-white p-6 shadow-tarjeta ring-1 ring-marca-rosa/30">
      <h3 class="font-display text-xl font-extrabold text-marca-morado">Cuéntanos tu experiencia</h3>

      <!-- Estrellas -->
      <div class="mt-4">
        <label class="block text-sm font-semibold text-marca-morado/80">Tu calificación</label>
        <div id="estrellas" class="mt-1 flex gap-1" role="radiogroup" aria-label="Calificación de 1 a 5 estrellas">
          {[1, 2, 3, 4, 5].map((n) => (
            <button
              type="button"
              class="estrella text-3xl text-marca-rosa/50 transition hover:scale-110"
              data-valor={n}
              role="radio"
              aria-checked="false"
              aria-label={`${n} estrella${n > 1 ? 's' : ''}`}
            >★</button>
          ))}
        </div>
        <input type="hidden" id="resena-calificacion" value="0" />
      </div>

      <div class="mt-4">
        <label for="resena-nombre" class="block text-sm font-semibold text-marca-morado/80">Tu nombre</label>
        <input
          type="text"
          id="resena-nombre"
          maxlength="60"
          required
          class="mt-1 w-full rounded-xl border border-marca-rosa/60 bg-white px-3 py-2 text-sm text-marca-morado placeholder:text-marca-morado/40 focus:border-marca-fucsia focus:outline-none focus:ring-2 focus:ring-marca-fucsia/30"
          placeholder="Ej: María G."
        />
      </div>

      <div class="mt-4">
        <label for="resena-comentario" class="block text-sm font-semibold text-marca-morado/80">Tu comentario</label>
        <textarea
          id="resena-comentario"
          rows="4"
          maxlength="500"
          required
          class="mt-1 w-full rounded-xl border border-marca-rosa/60 bg-white px-3 py-2 text-sm text-marca-morado placeholder:text-marca-morado/40 focus:border-marca-fucsia focus:outline-none focus:ring-2 focus:ring-marca-fucsia/30"
          placeholder="Me encantó el aroma y el detalle de la bolsa…"
        ></textarea>
      </div>

      <p id="resena-mensaje" class="mt-3 hidden rounded-xl px-3 py-2 text-sm"></p>

      <div class="mt-4 flex gap-3">
        <button type="submit" id="btn-enviar-resena" class="btn-primario flex-1">Enviar reseña</button>
        <button type="button" id="btn-cancelar-resena" class="btn-contorno">Cancelar</button>
      </div>
      <p class="mt-3 text-center text-[11px] text-marca-morado/50">
        Tu reseña será revisada antes de publicarse. 💜
      </p>
    </form>
  </div>
</section>

<script>
  const lista = document.getElementById('resenas-lista');
  const cargando = document.getElementById('resenas-cargando');
  const vacio = document.getElementById('resenas-vacio');
  const form = document.getElementById('form-resena');
  const btnAbrir = document.getElementById('btn-abrir-resena');
  const btnCancelar = document.getElementById('btn-cancelar-resena');
  const mensaje = document.getElementById('resena-mensaje');
  const inputCalif = document.getElementById('resena-calificacion');
  const estrellas = Array.from(document.querySelectorAll('.estrella'));

  const escapar = (s) =>
    String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const estrellasHtml = (n) =>
    '★★★★★☆☆☆☆☆'.slice(5 - n, 10 - n);

  // ---- Cargar reseñas aprobadas ----
  async function cargar() {
    try {
      const res = await fetch('/api/resenas');
      if (!res.ok) throw new Error('fetch');
      const data = await res.json();
      cargando?.classList.add('hidden');
      const resenas = data.resenas || [];
      if (resenas.length === 0) {
        vacio?.classList.remove('hidden');
        return;
      }
      resenas.forEach((r) => {
        const card = document.createElement('article');
        card.className = 'rounded-3xl bg-white p-5 shadow-tarjeta ring-1 ring-marca-rosa/30';
        card.innerHTML = `
          <div class="text-xl text-marca-amarillo" aria-label="${r.calificacion} de 5 estrellas">${estrellasHtml(r.calificacion)}</div>
          <p class="mt-2 text-sm text-marca-morado/80">“${escapar(r.comentario)}”</p>
          <p class="mt-3 font-bold text-marca-morado">— ${escapar(r.nombre)}</p>`;
        lista?.appendChild(card);
      });
    } catch {
      // Sin backend (p. ej. en dev local): mostrar estado vacío amable
      cargando?.classList.add('hidden');
      vacio?.classList.remove('hidden');
    }
  }

  // ---- Selector de estrellas ----
  let seleccion = 0;
  const pintar = (valor) => {
    estrellas.forEach((e) => {
      const v = Number(e.dataset.valor);
      e.classList.toggle('text-marca-amarillo', v <= valor);
      e.classList.toggle('text-marca-rosa/50', v > valor);
      e.setAttribute('aria-checked', String(v === valor));
    });
  };
  estrellas.forEach((e) => {
    const v = Number(e.dataset.valor);
    e.addEventListener('mouseenter', () => pintar(v));
    e.addEventListener('mouseleave', () => pintar(seleccion));
    e.addEventListener('click', () => { seleccion = v; inputCalif.value = String(v); pintar(v); });
  });

  // ---- Abrir / cerrar formulario ----
  btnAbrir?.addEventListener('click', () => {
    form?.classList.remove('hidden');
    form?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
  btnCancelar?.addEventListener('click', () => form?.classList.add('hidden'));

  const mostrarMensaje = (texto, ok) => {
    if (!mensaje) return;
    mensaje.textContent = texto;
    mensaje.classList.remove('hidden');
    mensaje.classList.toggle('bg-green-100', ok);
    mensaje.classList.toggle('text-green-800', ok);
    mensaje.classList.toggle('bg-red-100', !ok);
    mensaje.classList.toggle('text-red-800', !ok);
  };

  // ---- Enviar reseña ----
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nombre = document.getElementById('resena-nombre').value.trim();
    const comentario = document.getElementById('resena-comentario').value.trim();
    const calificacion = Number(inputCalif.value);
    if (calificacion < 1) { mostrarMensaje('Elige una calificación con las estrellas.', false); return; }
    if (!nombre || comentario.length < 3) { mostrarMensaje('Completa tu nombre y comentario.', false); return; }

    const btn = document.getElementById('btn-enviar-resena');
    btn.disabled = true;
    btn.textContent = 'Enviando…';
    try {
      const res = await fetch('/api/resenas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, comentario, calificacion }),
      });
      const data = await res.json();
      if (res.ok) {
        mostrarMensaje(data.mensaje || '¡Gracias por tu reseña! 💜', true);
        form.reset();
        seleccion = 0; inputCalif.value = '0'; pintar(0);
      } else {
        mostrarMensaje(data.error || 'No se pudo enviar. Intenta de nuevo.', false);
      }
    } catch {
      mostrarMensaje('No se pudo enviar. Revisa tu conexión e intenta de nuevo.', false);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar reseña';
    }
  });

  cargar();
</script>
