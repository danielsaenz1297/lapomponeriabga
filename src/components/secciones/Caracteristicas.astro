---
import { caracteristicas, espaciosIdeales } from '../../data/config';
---

<section id="caracteristicas" class="scroll-mt-20 py-16">
  <div class="contenedor">
    <div class="mx-auto max-w-2xl text-center">
      <span class="chip">✨ 100% artesanal</span>
      <h2 class="titulo-seccion mt-3">¿Por qué un AromaPom?</h2>
      <p class="mt-3 text-marca-morado/70">
        Un difusor de aroma hecho a mano, con pompón al estilo Wayúu, mensajes que inspiran
        y un kit de reciclaje para darle una segunda vida.
      </p>
    </div>

    <!-- Tarjetas de características -->
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {caracteristicas.map((c) => (
        <div class="flex gap-4 rounded-3xl bg-white p-5 shadow-tarjeta ring-1 ring-marca-rosa/30">
          <span class="text-3xl" aria-hidden="true">{c.icono}</span>
          <div>
            <h3 class="font-display text-lg font-extrabold text-marca-morado">{c.titulo}</h3>
            <p class="mt-1 text-sm text-marca-morado/70">{c.detalle}</p>
          </div>
        </div>
      ))}

      <!-- Tarjeta "dónde colocarlo" -->
      <div class="flex flex-col justify-center rounded-3xl bg-marca-rosaClaro p-5 ring-1 ring-marca-rosa/30">
        <span class="text-3xl" aria-hidden="true">🏡</span>
        <h3 class="mt-2 font-display text-lg font-extrabold text-marca-morado">Perfecto para cualquier espacio</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          {espaciosIdeales.map((e) => (
            <span class="chip bg-white">{e}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Galería de fotos de apoyo -->
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <figure class="overflow-hidden rounded-3xl shadow-suave ring-4 ring-white">
        <img src="/img/caracteristicas/donde-colocar.jpeg" alt="Espacios ideales para colocar el AromaPom: baño, oficina y habitación" class="w-full object-cover" loading="lazy" />
      </figure>
      <figure class="overflow-hidden rounded-3xl shadow-suave ring-4 ring-white">
        <img src="/img/caracteristicas/segunda-vida.jpeg" alt="Kit de reciclaje: cómo darle una segunda vida al AromaPom convirtiéndolo en velita" class="w-full object-cover" loading="lazy" />
      </figure>
      <figure class="overflow-hidden rounded-3xl shadow-suave ring-4 ring-white">
        <img src="/img/caracteristicas/artesanal.jpeg" alt="Detalle artesanal del AromaPom: pompón Wayúu, parafina refinada y mensajes motivacionales" class="w-full object-cover" loading="lazy" />
      </figure>
    </div>
  </div>
</section>
